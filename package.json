{
  "name": "codemaster",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "node --test tests/content.test.mjs",
    "build:web": "npm --workspace @codemaster/web run build",
    "build:api": "npm --workspace @codemaster/api run build",
    "build:worker": "npm --workspace @codemaster/execution-worker run build",
    "build": "npm run test && npm run build:web && npm run build:api && npm run build:worker"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
